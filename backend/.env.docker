PORT=3001
NODE_ENV=development

# Database – uses Docker service name "postgres" as host
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/hajj_booking

# Redis – uses Docker service name "redis" as host
REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
