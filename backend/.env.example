# Backend environment template — copy to `.env` if you want to run the API
# on the host (not inside Docker). When using `docker compose up`, the root
# `docker-compose.yml` already injects DATABASE_URL/REDIS_URL via the
# `environment:` block, so you don't need this file for that path.
#
#   cp backend/.env.example backend/.env
#   cd backend && npm install && npm run start:dev

PORT=3001
NODE_ENV=development

# Database — host = "localhost" because you're running on the host, NOT in Docker.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hajj_booking

# Redis — host = "localhost" for the same reason.
REDIS_URL=redis://localhost:6379

# JWT Authentication. CHANGE THESE BEFORE DEPLOYING.
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-different-from-jwt
JWT_REFRESH_EXPIRES_IN=7d
