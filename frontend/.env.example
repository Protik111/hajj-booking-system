# REST API base URL. The /api/v1 prefix matches the NestJS backend's
# global prefix (see backend/src/main.ts).
#
# Local dev default (used by `npm run dev`):
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# When running via `docker compose up` at the project root, the build
# uses ./frontend/.env.docker instead of this file (see docker-compose.yml
# `frontend.env_file`). The browser runs on the host, so the URL must be
# reachable from the host — `localhost:3001` works because the backend
# container publishes that port.

# For a deployed backend, override to the public origin + /api/v1, e.g.:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1