# Used by `docker compose up` (root) when building the frontend image.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
# The browser runs on the user's host machine, NOT inside the container network,
# so the URL must be reachable from the host. The backend container publishes
# its port to the host as `:3001`, so `localhost:3001` works in dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Non-prefixed env vars are read at runtime (not bundled), so they can use
# Docker service names. Server components run inside the frontend container,
# so they need to reach the backend by its service name, not by `localhost`
# (which would loop back to the frontend itself).
API_BASE_URL_SERVER=http://backend:3001/api/v1
